// traffic: a Moore machine, generated by Silinx from the state diagram traffic.fsm.json (edit the drawing, not this file).
// One tick every TICK_MS milliseconds: the inputs read once at its start, the outputs written to their pins at its end
// (Silinx's synchronous reactive model: docs/SYSTEMS.md).
// Inputs: req D2, done D3, night D4.
// Outputs: phase D5 D6 D7.
// (a port of several bits: its pins bit 0 first)

#include <Arduino.h>

// ---- the pins
const uint8_t PIN_REQ = 2;
const uint8_t PIN_DONE = 3;
const uint8_t PIN_NIGHT = 4;
const uint8_t PIN_PHASE[3] = { 5, 6, 7 };

const unsigned long TICK_MS = 10;   // the tick's period

// ---- the states
enum State { S_CARS, S_CARS_YELLOW, S_ALL_RED, S_WALK, S_WALK_END, S_ALL_RED_2, S_NIGHT };
//   CARS: cars green, pedestrians red (at least 5 s)
//   CARS_YELLOW: cars yellow (2 s)
//   ALL_RED: all red (1 s): the crossing clears
//   WALK: pedestrians green (5 s)
//   WALK_END: pedestrian green blinking (3 s): hurry up
//   ALL_RED_2: all red (1 s)
//   NIGHT: night: cars flashing yellow, pedestrian lamps off

// ---- the inputs, read once per tick
static uint8_t req;
static uint8_t done;
static uint8_t night;

// ---- the outputs
static uint8_t phase;   // 3 bits

// ---- the memory
static enum State state;

// a number to its pins, bit 0 first
static void writeBits(const uint8_t *pins, uint8_t n, uint32_t v) {
  for (uint8_t i = 0; i < n; i++) digitalWrite(pins[i], (v >> i) & 1 ? HIGH : LOW);
}

static void readInputs(void) {
  req = digitalRead(PIN_REQ) == HIGH;
  done = digitalRead(PIN_DONE) == HIGH;
  night = digitalRead(PIN_NIGHT) == HIGH;
}

static void writeOutputs(void) {
  writeBits(PIN_PHASE, 3, phase);
}

// the reset state
static void resetMachine(void) {
  state = S_CARS;
}

// one tick: the outputs of the present state and of the inputs, then the next state
static void stepMachine(void) {
  readInputs();
  // the outputs' defaults
  phase = 0;
  switch (state) {
    case S_CARS:
      phase = 0;
      if (night) {
        state = S_NIGHT;
      } else if (!night && req && done) {
        state = S_CARS_YELLOW;
      }
      break;
    case S_CARS_YELLOW:
      phase = 1;
      if (done) {
        state = S_ALL_RED;
      }
      break;
    case S_ALL_RED:
      phase = 2;
      if (done) {
        state = S_WALK;
      }
      break;
    case S_WALK:
      phase = 3;
      if (done) {
        state = S_WALK_END;
      }
      break;
    case S_WALK_END:
      phase = 4;
      if (done) {
        state = S_ALL_RED_2;
      }
      break;
    case S_ALL_RED_2:
      phase = 5;
      if (done) {
        state = S_CARS;
      }
      break;
    case S_NIGHT:
      phase = 6;
      if (!night) {
        state = S_CARS;
      }
      break;
  }
  writeOutputs();
}

void setup() {
  pinMode(PIN_REQ, INPUT);
  pinMode(PIN_DONE, INPUT);
  pinMode(PIN_NIGHT, INPUT);
  for (uint8_t i = 0; i < 3; i++) pinMode(PIN_PHASE[i], OUTPUT);
  resetMachine();
}

void loop() {
  static unsigned long lastTick = 0;
  if (millis() - lastTick < TICK_MS) return;
  lastTick += TICK_MS;
  stepMachine();
}
