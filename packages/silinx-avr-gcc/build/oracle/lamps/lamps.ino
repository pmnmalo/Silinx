// lamps: combinational logic, generated by Silinx from the truth table lamps.bool.json (edit the drawing, not this file).
// One tick every TICK_MS milliseconds: the inputs read once at its start, the outputs written to their pins at its end
// (Silinx's synchronous reactive model: docs/SYSTEMS.md).
// Inputs: phase2 D2, phase1 D3, phase0 D4, blink D5.
// Outputs: car_r D6, car_y D7, car_g D8, walk_r D9, walk_g D10.

#include <Arduino.h>

// ---- the pins
const uint8_t PIN_PHASE2 = 2;
const uint8_t PIN_PHASE1 = 3;
const uint8_t PIN_PHASE0 = 4;
const uint8_t PIN_BLINK = 5;
const uint8_t PIN_CAR_R = 6;
const uint8_t PIN_CAR_Y = 7;
const uint8_t PIN_CAR_G = 8;
const uint8_t PIN_WALK_R = 9;
const uint8_t PIN_WALK_G = 10;

const unsigned long TICK_MS = 10;   // the tick's period

// ---- the inputs, read once per tick
static uint8_t phase2;
static uint8_t phase1;
static uint8_t phase0;
static uint8_t blink;

// ---- the outputs
static uint8_t car_r;
static uint8_t car_y;
static uint8_t car_g;
static uint8_t walk_r;
static uint8_t walk_g;

static void readInputs(void) {
  phase2 = digitalRead(PIN_PHASE2) == HIGH;
  phase1 = digitalRead(PIN_PHASE1) == HIGH;
  phase0 = digitalRead(PIN_PHASE0) == HIGH;
  blink = digitalRead(PIN_BLINK) == HIGH;
}

static void writeOutputs(void) {
  digitalWrite(PIN_CAR_R, car_r ? HIGH : LOW);
  digitalWrite(PIN_CAR_Y, car_y ? HIGH : LOW);
  digitalWrite(PIN_CAR_G, car_g ? HIGH : LOW);
  digitalWrite(PIN_WALK_R, walk_r ? HIGH : LOW);
  digitalWrite(PIN_WALK_G, walk_g ? HIGH : LOW);
}

// the reset state
static void resetMachine(void) {
}

// one tick: the outputs of the inputs
static void stepMachine(void) {
  readInputs();
  car_r = (!phase2 && phase1) || (phase2 && !phase1);
  car_y = (!phase2 && !phase1 && phase0) || (phase2 && phase1 && blink);
  car_g = !phase2 && !phase1 && !phase0;
  walk_r = (!phase2 && !phase0) || (!phase1 && phase0);
  walk_g = (phase1 && phase0) || (phase2 && !phase1 && !phase0 && blink);
  writeOutputs();
}

void setup() {
  pinMode(PIN_PHASE2, INPUT);
  pinMode(PIN_PHASE1, INPUT);
  pinMode(PIN_PHASE0, INPUT);
  pinMode(PIN_BLINK, INPUT);
  pinMode(PIN_CAR_R, OUTPUT);
  pinMode(PIN_CAR_Y, OUTPUT);
  pinMode(PIN_CAR_G, OUTPUT);
  pinMode(PIN_WALK_R, OUTPUT);
  pinMode(PIN_WALK_G, OUTPUT);
  resetMachine();
}

void loop() {
  static unsigned long lastTick = 0;
  if (millis() - lastTick < TICK_MS) return;
  lastTick += TICK_MS;
  stepMachine();
}
