// alarm: a Moore machine, generated by Silinx from the Petri net alarm.pn.json (edit the drawing, not this file).
// One tick every TICK_MS milliseconds: the inputs read once at its start, the outputs written to their pins at its end
// (Silinx's synchronous reactive model: docs/SYSTEMS.md).
// Inputs: fail D2, opened D3.
// Outputs: fails D4 D5, alarm D6.
// (a port of several bits: its pins bit 0 first)

#include <Arduino.h>

// ---- the pins
const uint8_t PIN_FAIL = 2;
const uint8_t PIN_OPENED = 3;
const uint8_t PIN_FAILS[2] = { 4, 5 };
const uint8_t PIN_ALARM = 6;

const unsigned long TICK_MS = 10;   // the tick's period

// ---- the states
enum State { S_none, S_one, S_two, S_alarmed };
//   none: none=1, one=0, two=0, alarmed=0
//   one: none=0, one=1, two=0, alarmed=0
//   two: none=0, one=0, two=1, alarmed=0
//   alarmed: none=0, one=0, two=0, alarmed=1

// ---- the inputs, read once per tick
static uint8_t fail;
static uint8_t opened;

// ---- the outputs
static uint8_t fails;   // 2 bits
static uint8_t alarm;

// ---- the memory
static enum State state;

// a number to its pins, bit 0 first
static void writeBits(const uint8_t *pins, uint8_t n, uint32_t v) {
  for (uint8_t i = 0; i < n; i++) digitalWrite(pins[i], (v >> i) & 1 ? HIGH : LOW);
}

static void readInputs(void) {
  fail = digitalRead(PIN_FAIL) == HIGH;
  opened = digitalRead(PIN_OPENED) == HIGH;
}

static void writeOutputs(void) {
  writeBits(PIN_FAILS, 2, fails);
  digitalWrite(PIN_ALARM, alarm ? HIGH : LOW);
}

// the reset state
static void resetMachine(void) {
  state = S_none;
}

// one tick: the outputs of the present state and of the inputs, then the next state
static void stepMachine(void) {
  readInputs();
  // the outputs' defaults
  fails = 0;
  alarm = 0;
  switch (state) {
    case S_none:
      if (fail) {
        state = S_one;
      }
      break;
    case S_one:
      fails = 1;
      if (!fail && opened) {
        state = S_none;
      } else if (fail) {
        state = S_two;
      }
      break;
    case S_two:
      fails = 2;
      if (!fail && opened) {
        state = S_none;
      } else if (fail) {
        state = S_alarmed;
      }
      break;
    case S_alarmed:
      fails = 3;
      alarm = 1;
      break;
  }
  writeOutputs();
}

void setup() {
  pinMode(PIN_FAIL, INPUT);
  pinMode(PIN_OPENED, INPUT);
  for (uint8_t i = 0; i < 2; i++) pinMode(PIN_FAILS[i], OUTPUT);
  pinMode(PIN_ALARM, OUTPUT);
  resetMachine();
}

void loop() {
  static unsigned long lastTick = 0;
  if (millis() - lastTick < TICK_MS) return;
  lastTick += TICK_MS;
  stepMachine();
}
