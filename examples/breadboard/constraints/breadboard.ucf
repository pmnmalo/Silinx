# UCF for top 'breadboard' on Digilent Basys2 (xc3s250e-4-cp132), generated by Silinx

NET "clk"    LOC = "B8" ;
NET "clk"    CLOCK_DEDICATED_ROUTE = FALSE ;
NET "btn<0>" LOC = "G12" ;
NET "sw<0>"  LOC = "P11" ;
NET "led<0>" LOC = "M5" ;
NET "led<1>" LOC = "M11" ;
NET "led<2>" LOC = "P7" ;
NET "led<3>" LOC = "P6" ;
NET "led<4>" LOC = "N5" ;
NET "led<5>" LOC = "N4" ;
NET "led<6>" LOC = "P4" ;
NET "led<7>" LOC = "G1" ;

# Timing constraints
NET "clk" TNM_NET = "clk" ;
TIMESPEC "TS_clk" = PERIOD "clk" 20 ns HIGH 50% ;
